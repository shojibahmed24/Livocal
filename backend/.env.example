# ===============================================================
# Livocal - Gemini Live WebSocket Relay Server Environment
# ===============================================================

# Port to listen on (Default: 8080)
PORT=8080

# Google AI Studio Gemini API Key (Backend holds this securely)
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=

# Default Gemini Live Model ID
GEMINI_LIVE_MODEL=models/gemini-3.5-live-translate-preview

# Default Voice Profile: Aoede | Puck | Kore | Charon | Fenrir
DEFAULT_VOICE=Aoede

# Firebase Admin Service Account JSON (as single-line JSON string)
FIREBASE_SERVICE_ACCOUNT=

# WebRTC TURN Relay Configuration (Critical for Symmetric NAT / 4G / 5G Mobile Data)
# Option A: Ephemeral Coturn Server (RFC 5766 REST API with HMAC-SHA1 auth) - Recommended
TURN_URL=turn:turn.livocal.com:3478?transport=udp,turn:turn.livocal.com:3478?transport=tcp,turns:turn.livocal.com:5349?transport=tcp
TURN_SECRET=your_coturn_static_auth_secret
TURN_TTL_SECONDS=86400

# Option B: Static / Managed TURN Provider (e.g. Metered.ca, Twilio, Xirsys)
# TURN_URL=turn:standard.relay.metered.ca:80
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_password
