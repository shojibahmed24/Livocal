# ===============================================================
# WhatsUp - Gemini Live WebSocket Relay Server Environment
# ===============================================================

# Port to listen on (Default: 8080)
PORT=8080

# Google AI Studio Gemini API Key (Backend holds this securely)
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=

# Default Gemini Live Model ID
# Options:
# - models/gemini-2.0-flash-live-001 (Recommended Stable)
# - models/gemini-2.5-flash-native-audio-preview-12-2025
# - models/gemini-3.5-flash-live-preview
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-live-001

# Default Voice Profile: Aoede | Puck | Kore | Charon | Fenrir
DEFAULT_VOICE=Aoede
