# ===============================================================
# Livocal - Gemini Live WebSocket Relay Server Environment
# ===============================================================

# Port to listen on (Default: 8080)
PORT=8080

# Google AI Studio Gemini API Key (Backend holds this securely)
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=

# Default Gemini Live Model ID
GEMINI_LIVE_MODEL=models/gemini-3.5-live-translate-preview

# Default Voice Profile: Aoede | Puck | Kore | Charon | Fenrir
DEFAULT_VOICE=Aoede

# Relay Security Secret (Shared between backend and Livocal app)
RELAY_API_SECRET=livocal_relay_secure_v1_2026

# Firebase Admin Service Account JSON (as single-line JSON string)
FIREBASE_SERVICE_ACCOUNT=

# Optional WebRTC TURN Server configuration
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
