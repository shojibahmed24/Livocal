rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Profile Avatars (Max 5MB, Image types only, strictly owner-owned)
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName.matches(request.auth.uid + '.*')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/.*');
    }

    match /userAvatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/.*');
    }

    // 2. Chat Attachments & Voice Notes
    // Scoped 1-on-1 Chat Attachments: Strictly restricted to Sender and Receiver
    match /attachments/{senderId}/{receiverId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == senderId || request.auth.uid == receiverId
      );
      allow create: if request.auth != null && request.auth.uid == senderId
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && fileName.size() <= 128
        && request.resource.contentType.matches('^(image|video|audio|application/pdf|text/plain).*');
      allow update, delete: if false;
    }

    // Deprecated legacy root attachments: Deny new uploads; read/delete permitted only if authenticated user is the sender/receiver or filename matches caller UID
    match /attachments/{fileName} {
      allow create, update: if false;
      allow delete: if request.auth != null && (
        (resource.metadata != null && resource.metadata.senderId == request.auth.uid) ||
        fileName.matches(request.auth.uid + '.*')
      );
      allow read: if request.auth != null && (
        (resource.metadata != null && (
          resource.metadata.senderId == request.auth.uid ||
          resource.metadata.receiverId == request.auth.uid
        )) ||
        fileName.matches(request.auth.uid + '.*')
      );
    }

    // 3. Ephemeral Status Images (Max 10MB, strictly owner-owned & recipient authorized)
    match /statuses/{userId}/{fileName} {
      // Author can always read their status image; authorized recipients can read if in customMetadata.allowedUserIds
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.metadata != null && resource.metadata.allowedUserIds != null && request.auth.uid in resource.metadata.allowedUserIds.split(','))
      );
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image|video).*');
      allow update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deprecated legacy root statuses: Deny new uploads; read/delete permitted only for the author
    match /statuses/{fileName} {
      allow create, update: if false;
      allow delete: if request.auth != null && (
        (resource.metadata != null && resource.metadata.authorId == request.auth.uid) ||
        fileName.matches(request.auth.uid + '.*')
      );
      allow read: if request.auth != null && (
        (resource.metadata != null && resource.metadata.authorId == request.auth.uid) ||
        fileName.matches(request.auth.uid + '.*')
      );
    }
  }
}
