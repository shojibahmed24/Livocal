rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Profile Avatars
    match /userAvatars/{userId} {
      // Authenticated users can view user avatars
      allow read: if request.auth != null;
      // Users can only upload and modify their own avatar
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Chat Attachments & Voice Notes
    match /attachments/{fileName} {
      // Authenticated users can upload and download chat attachments
      allow read, write: if request.auth != null;
    }
  }
}
