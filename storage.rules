rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Profile Avatars (Max 5MB, Image types only, strictly owner-owned)
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName.matches(request.auth.uid + '.*')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/.*');
    }

    match /userAvatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/.*');
    }

    // 2. Chat Attachments & Voice Notes
    match /attachments/{fileName} {
      // Authenticated users can read chat attachments
      allow read: if request.auth != null;
      // Authenticated users can upload new attachments (max 25MB per file, valid media/doc MIME only)
      allow create: if request.auth != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && fileName.size() <= 128
        && request.resource.contentType.matches('^(image|video|audio|application/pdf|text/plain).*');
      // Chat attachments are immutable once uploaded (cannot be overwritten or deleted by anyone)
      allow update, delete: if false;
    }
  }
}
