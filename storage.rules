rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 1. Profile Avatars (Max 5MB, Image types only, strictly owner-owned)
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName.matches(request.auth.uid + '.*')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/.*');
    }

    match /userAvatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/.*');
    }

    // 2. Chat Attachments & Voice Notes
    // Scoped 1-on-1 Chat Attachments: Strictly restricted to Sender and Receiver
    match /attachments/{senderId}/{receiverId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == senderId || request.auth.uid == receiverId
      );
      allow create: if request.auth != null && request.auth.uid == senderId
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && fileName.size() <= 128
        && request.resource.contentType.matches('^(image|video|audio|application/pdf|text/plain).*');
      allow update, delete: if false;
    }

    // Deprecated legacy root attachments: Deny new uploads; read only if metadata proves ownership
    match /attachments/{fileName} {
      allow create: if false;
      allow read: if request.auth != null && resource.metadata != null && (
        resource.metadata.senderId == request.auth.uid ||
        resource.metadata.receiverId == request.auth.uid
      );
      allow update, delete: if false;
    }

    // 3. Ephemeral Status Images (Max 10MB, strictly owner-owned)
    match /statuses/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && fileName.matches(request.auth.uid + '.*')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image|video).*');
      allow update, delete: if request.auth != null
        && fileName.matches(request.auth.uid + '.*');
    }
  }
}
