rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCallParty(callData) {
      return isAuthenticated() && callData != null && (
        callData.callerId == request.auth.uid ||
        callData.calleeId == request.auth.uid ||
        (
          request.auth.token.phone_number != null && (
            callData.calleeId == ('phone_' + request.auth.token.phone_number) ||
            callData.calleeId == request.auth.token.phone_number
          )
        )
      );
    }

    function isCallParticipant(callId) {
      let callDoc = get(/databases/$(database)/documents/calls/$(callId)).data;
      return isCallParty(callDoc);
    }

    // 1. User Profiles & Realtime Presence
    match /users/{userId} {
      // Security: Allow get for individual profile inspection by known ID
      allow get: if isAuthenticated();
      // Anti-enumeration defense: Disallow collection listing entirely to prevent userbase crawling & scraping.
      // Targeted phone lookups and contact discovery MUST go through authenticated server endpoints (/api/contacts/match) via Admin SDK.
      allow list: if false;

      // Doc squatting defense & PII isolation:
      // Users can ONLY create, update, or delete their own profile document,
      // and internal data.id MUST strictly match request.auth.uid and document ID.
      // Financial payment addresses (bKash, Nagad, Crypto, Binance Pay) MUST NOT be stored in the public user doc.
      // Helper: Checks that a sensitive payment field is not introduced or altered.
      // Prevents blocking legacy users from normal profile/presence updates while migration proceeds,
      // while strictly rejecting any addition/modification of payment fields and allowing deletion.
      function paymentFieldClean(fieldName) {
        return !(fieldName in request.resource.data) ||
               !(request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName]));
      }

      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.id == request.auth.uid
        && !('binancePayId' in request.resource.data)
        && !('cryptoUsdtTrc20' in request.resource.data)
        && !('cryptoUsdtBep20' in request.resource.data)
        && !('bkashNumber' in request.resource.data)
        && !('nagadNumber' in request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid == userId && request.resource.data.id == resource.data.id
        && paymentFieldClean('binancePayId')
        && paymentFieldClean('cryptoUsdtTrc20')
        && paymentFieldClean('cryptoUsdtBep20')
        && paymentFieldClean('bkashNumber')
        && paymentFieldClean('nagadNumber');
      allow delete: if isAuthenticated() && request.auth.uid == userId;

      // Companion Linked Devices (Web, Desktop, Companion apps)
      match /linked_devices/{deviceId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Blocked Contacts Subcollection (Owner manages their own blocklist)
      match /blocked_users/{contactId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Muted Contacts Subcollection (Owner manages per-contact mute preferences)
      match /muted_contacts/{contactId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // SaaS Freelancer Minute Wallet & Payment Settings
      // Owner can ONLY read and manage their own private wallet subcollection.
      // Third-party access is strictly prohibited (preventing bulk scraping of bKash/Nagad/Crypto addresses).
      match /wallet/{walletId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if isAuthenticated() && request.auth.uid == userId && walletId == 'payment_settings';
      }
    }

    // 2. Chat Inboxes & Realtime Message Queue
    match /chats/{receiverId} {
      // Only the inbox owner can read or manage their inbox document
      allow read, write: if isAuthenticated() && request.auth.uid == receiverId;

      match /messages/{messageId} {
        // Authenticated sender can deliver a message or status update receipt to recipient's inbox
        // Security: Strictly enforce senderId == request.auth.uid to prevent impersonation/message injection
        // Enforcement: Cannot send messages to a user who has blocked the sender
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid
          && !exists(/databases/$(database)/documents/users/$(receiverId)/blocked_users/$(request.auth.uid));
        // Only recipient or sender can read, update (delivery ticks), or delete
        allow read, delete: if isAuthenticated() && (
          request.auth.uid == receiverId ||
          request.auth.uid == resource.data.senderId
        );
        allow update: if isAuthenticated() && (
          request.auth.uid == receiverId ||
          request.auth.uid == resource.data.senderId
        );
      }
    }

    // Shared Per-Chat Settings (Disappearing messages duration, shared timers)
    // Security: Only legitimate participants of this specific chat can read or update chat settings
    match /chat_settings/{chatId} {
      allow read: if isAuthenticated() && (
        (resource.data != null && resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('^' + request.auth.uid + '_.*') ||
        chatId.matches('^.*_' + request.auth.uid + '$')
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        chatId.matches('^' + request.auth.uid + '_.*') ||
        chatId.matches('^.*_' + request.auth.uid + '$')
      ) && (
        request.resource.data.updatedBy == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        (resource.data != null && resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('^' + request.auth.uid + '_.*') ||
        chatId.matches('^.*_' + request.auth.uid + '$')
      ) && (
        request.resource.data.updatedBy == request.auth.uid
      );
      allow delete: if false;
    }

    // 3. Audio / Video Calling & Gemini Live Translations
    match /calls/{callId} {
      // Authenticated caller initiates the call session
      // Enforcement: Caller cannot initiate call to a recipient who has blocked them
      allow create: if isAuthenticated()
        && request.resource.data.callerId == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.calleeId)/blocked_users/$(request.auth.uid));
      // Both participants (caller & verified callee) can observe and update call state
      // Security: Caller & Callee IDs cannot be spoofed or mutated to hijack existing calls
      allow read: if isCallParty(resource.data);
      allow update: if isCallParty(resource.data)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if isCallParty(resource.data);

      // WebRTC ICE Candidates (Caller) - Restricted strictly to call participants
      match /callerCandidates/{candidateId} {
        allow read, write: if isCallParticipant(callId);
      }

      // WebRTC ICE Candidates (Callee) - Restricted strictly to call participants
      match /calleeCandidates/{candidateId} {
        allow read, write: if isCallParticipant(callId);
      }

      // Backward compatibility for generic candidates
      match /candidates/{candidateId} {
        allow read, write: if isCallParticipant(callId);
      }

      // Real-time live transcriptions (Restricted strictly to call participants)
      match /transcripts/{transcriptId} {
        allow read, write: if isCallParticipant(callId);
      }
    }

    // 4. FCM Push Notification Registration Tokens (Owner only, server accesses via Admin SDK)
    match /fcmTokens/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 5. Ephemeral 24-Hour Status Updates (Multi-User Stories)
    // Security: Only status author or explicit recipients in allowedUserIds can read
    match /statuses/{statusId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.allowedUserIds != null && request.auth.uid in resource.data.allowedUserIds)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 6. User Feedback & Support Submissions
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // 7. Device Fingerprints (Trial fraud protection - Server Admin SDK only)
    match /device_fingerprints/{fingerprintId} {
      allow read, write: if false;
    }

    // 8. Call Billing Records (Immutable ledger of translated call minute deductions)
    match /call_billing_records/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );
      allow write: if false;
    }

    // 9. Recharge Transactions (User can read their own, writes server-only)
    match /recharge_transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // 10. Payment Requests (Users can read their own submissions, writes server-only)
    match /payment_requests/{reqId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // 11. AI Call Summaries (Created by Relay Server Admin SDK, read by call participants)
    match /call_summaries/{summaryId} {
      allow read: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow write: if false;
    }

    // 12. P2P Minute Transfers (Immutable audit ledger - created only via trusted backend transaction)
    match /p2p_transfers/{transferId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow write: if false; // Server-only creation prevents client audit forgery
    }

    // 13. P2P In-Chat Payment Audit Records (bKash, Nagad, Crypto USDT)
    match /p2p_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      // Strictly constrain client create: must be pending, non-empty amount, valid currency
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is string &&
        request.resource.data.amount.size() > 0 &&
        request.resource.data.currency in ['BDT', 'USDT', 'MINUTES'];
      allow update, delete: if false; // Status changes (verified/flagged) reserved for Admin SDK
    }

    // 14. Contact & Abuse Reports (Security review ledger)
    match /reports/{reportId} {
      // Authenticated users can submit reports against abusive contacts.
      // reporterId must strictly match authenticated user's uid.
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reportedUserId is string &&
        request.resource.data.reason is string;
      // Reports cannot be read, updated, or deleted by clients — strictly reserved for Admin SDK review
      allow read, update, delete: if false;
    }
  }
}
