rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCallParticipant(callData) {
      return isAuthenticated() && (
        callData.callerId == request.auth.uid ||
        callData.calleeId == request.auth.uid
      );
    }

    // 1. User Profiles & Realtime Presence
    match /users/{userId} {
      // Authenticated users can view registered contacts & online/offline presence
      allow read: if isAuthenticated();
      // Users can only create or update their own profile document
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.resource.data.id == request.auth.uid
      );
    }

    // 2. Chat Inboxes & Realtime Message Queue
    match /chats/{receiverId} {
      // Only the inbox owner can read or manage their inbox document
      allow read: if isAuthenticated() && request.auth.uid == receiverId;
      allow write: if isAuthenticated();

      match /messages/{messageId} {
        // Authenticated sender can deliver a message to recipient's inbox
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        // Only recipient or sender can read, update (delivery ticks), or delete
        allow read, delete: if isAuthenticated() && (
          request.auth.uid == receiverId ||
          request.auth.uid == resource.data.senderId
        );
        allow update: if isAuthenticated() && (
          request.auth.uid == receiverId ||
          request.auth.uid == resource.data.senderId
        );
      }
    }

    // 3. Audio / Video Calling & Gemini Live Translations
    match /calls/{callId} {
      // Authenticated caller initiates the call session
      allow create: if isAuthenticated() && request.resource.data.callerId == request.auth.uid;
      // Both participants (caller & callee) can observe and update call state
      allow read, update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid ||
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.calleeId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );

      // WebRTC ICE Candidates (Caller)
      match /callerCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }

      // WebRTC ICE Candidates (Callee)
      match /calleeCandidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }

      // Backward compatibility for generic candidates
      match /candidates/{candidateId} {
        allow read, write: if isAuthenticated();
      }

      // Real-time live transcriptions (Restricted strictly to call participants)
      match /transcripts/{transcriptId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 4. FCM Push Notification Registration Tokens
    match /fcmTokens/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
