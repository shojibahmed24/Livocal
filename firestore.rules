rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles & Realtime Presence
    match /users/{userId} {
      // Authenticated users can view contacts & online/offline presence status
      allow read: if request.auth != null;
      // Users can only create or update their own profile document
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.id == request.auth.uid
      );
    }

    // 2. Chat Inboxes & Realtime Message Queue
    // Senders push incoming message to recipient's queue at /chats/{receiverId}/messages/{messageId}
    match /chats/{receiverId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        // Any authenticated sender can deliver a message to a recipient's inbox
        allow create: if request.auth != null;
        // The recipient or sender can read, update (delivery status), or consume/delete
        allow read, delete: if request.auth != null && (
          request.auth.uid == receiverId ||
          request.auth.uid == resource.data.senderId
        );
        allow update: if request.auth != null && (
          request.auth.uid == receiverId ||
          request.auth.uid == resource.data.senderId
        );
      }
    }

    // 3. Audio / Video Calling & Gemini Live Translations
    match /calls/{callId} {
      // Caller initiates the call session
      allow create: if request.auth != null;
      // Both participants (caller & callee) can observe and update call state/languages
      allow read, update: if request.auth != null && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid ||
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.calleeId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );

      // Real-time live transcriptions for Gemini Live Audio Translation
      match /transcripts/{transcriptId} {
        allow read, write: if request.auth != null;
      }

      // WebRTC ICE Candidates
      match /candidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }

    // 4. FCM Push Notification Registration Tokens
    match /fcmTokens/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
